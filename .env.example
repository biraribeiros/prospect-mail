# Copie para .env (cp .env.example .env) e preencha. O arquivo .env NUNCA vai para o GitHub.

# --- Ambiente ---
# dev | prod (em prod a SECRET_KEY padrão é recusada)
APP_ENV=dev
# SEGURANÇA DE ENVIO: só o valor exato "false" envia email de verdade. Qualquer outro = simulação.
DRY_RUN=true

# --- Banco (o docker-compose já aponta para o container) ---
POSTGRES_USER=prospector
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=prospector

# --- Segredos ---
# Gere com: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-um-valor-longo-e-aleatorio
# Chaves de criptografia (Fernet), separadas por vírgula, a MAIS NOVA primeiro.
# Gere com: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEYS=
# Em produção use true (cookie só trafega por HTTPS)
SESSION_HTTPS_ONLY=false

# --- Primeiro acesso (usado só pela semente, na primeira subida) ---
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha

# --- Conformidade ---
RETENTION_DAYS=730

# --- Chaves de API (etapas futuras) ---
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- Coleta de empresas (Etapa 2a) ---
# Estimativa em US$ por 1.000 consultas do Google Places (a tabela do Google muda: confira antes de rodar)
PLACES_PRICE_PER_1000_USD=35
# A busca no Google para sozinha ao atingir este gasto por execução
PLACES_MAX_USD_PER_RUN=5
# Pasta com os arquivos da base CNPJ da Receita (Empresas, Estabelecimentos, Socios, Municipios)
CNPJ_DIR=data/cnpj
